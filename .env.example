# --- Database ---
# Dev: SQLite (default). Prod: switch provider to "postgresql" in prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# --- Auth ---
# Secret used to sign CRM session JWTs. Generate: openssl rand -base64 48
AUTH_SECRET="change-me-in-production-please-use-a-long-random-string"

# Default admin created by the seed (change after first login)
SEED_ADMIN_EMAIL="admin@g75.local"
SEED_ADMIN_PASSWORD="admin12345"

# --- Public site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_PHONE="+380963940288"

# --- Messengers (shown in the booking header + confirmation) ---
# Viber is on one number, Telegram on another (per client's site)
NEXT_PUBLIC_VIBER_URL="viber://chat?number=%2B380994895161"
# Telegram channel/group used in the header: https://t.me/Lasertag_G75
# NEXT_PUBLIC_TELEGRAM_URL is the CONFIRMATION BOT deep-link target (create via @BotFather)
NEXT_PUBLIC_TELEGRAM_URL="https://t.me/g75lasertag_bot"

# --- Telegram confirmation bot ---
# Bot token from @BotFather. Used by the webhook to receive "confirm" starts.
TELEGRAM_BOT_TOKEN=""
# Chat id / channel where new bookings are announced to managers
TELEGRAM_MANAGER_CHAT_ID=""
# Secret path token protecting the webhook endpoint
TELEGRAM_WEBHOOK_SECRET="change-me"
